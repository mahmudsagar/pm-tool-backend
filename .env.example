PORT=3001

# Comma-separated list of allowed frontend origins for Socket.io CORS
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.com

# MONDODB URI
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/betternotion

# R2 Creadentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# JSON WEB TOKEN
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/github/callback
